{
    setlocale(LC_ALL, "Russian");
    char c;
    int a, b = 0, s;
    cout << "Введите код курса (P, M, W): ";
    cin >> c;
    switch (c)
    {
    case 'P': s = 65; break;
    case 'M': s = 70; break;
    case 'W': s = 60; break;
    default:
        cout << "Ошибка ввода";
