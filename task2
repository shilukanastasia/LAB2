#include <iostream>
#include <clocale>
using namespace std;
int main()
{
    setlocale(LC_ALL, "Russian");
    double a;
    int b, c;
    cout << "Введите средний балл (0-10): ";
    cin >> a;
    cout << "Введите посещаемость (0-100): ";
    cin >> b;
    cout << "Введите количество задолженностей: ";
    cin >> c;
    if (a < 0 || a > 10 || b < 0 || b > 100 || c < 0)
    {
        cout << "Ошибка ввода";
        return 0;
    }
    if (c == 0 && a >= 9.5 && b >= 70)
    {
        cout << "Можно выбрать углубленный курс\n";
        cout << "Правило: средний балл не ниже 9.5, посещаемость не ниже 70%";
    }
    else if (c == 0 && a >= 8 && b >= 80)
    {
        cout << "Можно выбрать углубленный курс\n";
        cout << "Правило: средний балл не ниже 8, посещаемость не ниже 80%";
    }
    else
    {
        cout << "Нельзя выбрать углубленный курс\n";
        if (c > 0)
            cout << "Причина: имеются задолженности\n";
        if (a < 8)
            cout << "Причина: недостаточный средний балл\n";
        if (b < 70 || (b < 80 && a < 9.5))
            cout << "Причина: недостаточная посещаемость\n";
    }
    return 0;
}
